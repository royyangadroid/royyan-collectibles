{
  "name": "royyan-collectibles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-data.js",
    "dev": "concurrently \"npm run watch-data\" \"next dev\"",
    "watch-data": "chokidar \"public/catalog\" \"public/sold.json\" -c \"node scripts/sync-data.js\"",
    "prebuild": "node scripts/sync-data.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sync-data": "node scripts/sync-data.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.416.0",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
